<?xml version="1.0" encoding="utf-8"?>
<!-- Author: TronShark -->
<!-- Version: v1.0 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/widget_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_status_dot_inactive"
            android:contentDescription="Status indicator" />

        <TextView
            android:id="@+id/widget_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WAKEMEUP • TRAVEL ALARM"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A09CAE"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Active Alarm Content -->
    <LinearLayout
        android:id="@+id/widget_active_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Destination Title -->
        <TextView
            android:id="@+id/widget_destination_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Destination Title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Key Metrics Cards (2-column layout) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Distance Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/widget_badge_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#A09CAE" />

                <TextView
                    android:id="@+id/widget_distance_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="📏 0 m"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Speed & ETA Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/widget_badge_bg"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEED &amp; ETA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#A09CAE" />

                <TextView
                    android:id="@+id/widget_speed_eta_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="⚡ 0 km/h • ⏱️ --"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E0E0E0"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

        </LinearLayout>

        <!-- Stop Alarm Button -->
        <TextView
            android:id="@+id/btn_stop_alarm"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_button_bg"
            android:gravity="center"
            android:text="🛑 STOP ALARM"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/widget_empty_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_badge_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No Active Alarm • Open app to set stop"
            android:textSize="13sp"
            android:textColor="#A09CAE"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
